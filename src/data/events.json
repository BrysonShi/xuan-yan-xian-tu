        "failureResult": {
          "resultText": "坊市的灵药品质一般，你花了些灵石但没买到什么好东西。不过和陈墨聊了一路，心情不错。",
          "resourceChanges": { "spiritStones": -5 },
          "relationshipChanges": [{ "npcId": "chenmo", "affinity": 5 }]
        }
      },
      {
        "id": "B",
        "text": "婉言谢绝",
        "description": "今天想专心修炼",
        "successRate": 1.0,
        "successResult": {
          "resultText": "你婉拒了陈墨的邀请，继续潜心修炼。陈墨虽然有些失望，但表示理解。",
          "cultivationChange": "5%",
          "relationshipChanges": [{ "npcId": "chenmo", "affinity": -3 }]
        }
      }
    ],
    "maxTriggerCount": null,
    "cooldown": 3,
    "isUnique": false
  },
  {
    "id": "EVT-C01",
    "name": "妖兽袭击",
    "category": "combat",
    "scene": "simulation",
    "triggerConditions": [
      { "type": "attribute_check", "field": "realmLevel", "operator": ">=", "value": 1 }
    ],
    "weight": 15,
    "weightModifiers": [
      {
        "condition": { "type": "attribute_check", "field": "attributes.luck", "operator": "<", "value": 15 },
        "multiplier": 2.0
      }
    ],
    "description": "外出途中，一头体型硕大的灰狼妖突然从灌木丛中窜出！它浑身散发着淡淡的妖气，赤红的双眼死死盯着你，显然已经锁定猎物。",
    "options": [
      {
        "id": "A",
        "text": "拔剑迎战",
        "description": "以攻伐之术斩杀妖兽",
        "successRate": 0.6,
        "successResult": {
          "resultText": "你凝聚灵力一剑斩出，灰狼妖惨叫一声倒地。你从它体内取出了妖核。",
          "hpChange": -15,
          "itemsGained": [{ "itemId": "ITM-M01", "quantity": 1 }],
          "resourceChanges": { "spiritStones": 5 }
        },
        "failureResult": {
          "resultText": "灰狼妖速度极快，你被它抓伤了手臂，不得不狼狈撤退。",
          "hpChange": -30
        }
      },
      {
        "id": "B",
        "text": "施展法术远程攻击",
        "description": "保持距离，以法术消耗它",
        "successRate": 0.55,
        "successResult": {
          "resultText": "你凝聚灵力发出一道火球，正中灰狼妖。它挣扎了几下便不再动弹。",
          "mpChange": -15,
          "itemsGained": [{ "itemId": "ITM-M01", "quantity": 1 }]
