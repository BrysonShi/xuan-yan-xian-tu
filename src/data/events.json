    "triggerConditions": [
      { "type": "attribute_check", "field": "realmLevel", "operator": ">=", "value": 1 }
    ],
    "weight": 15,
    "weightModifiers": [],
    "description": "陈墨匆匆赶来，脸上带着几分兴奋：'师兄，我打听到坊市今日有一批新到的灵药，价格比平日便宜不少。要不要一起去看看？顺便路上还能切磋一二。'",
    "options": [
      {
        "id": "A",
        "text": "欣然同往",
        "description": "正好也需要补充些物资",
        "successRate": 0.85,
